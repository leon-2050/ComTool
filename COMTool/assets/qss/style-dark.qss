   Derived from https://github.com/Neutree/COMTool; original copyright retained.
   Source remains under LGPLv3; see LICENSE, COPYING.LESSER and COPYING. */
/* Studio theme: navy navigation, cyan actions and a dedicated receive console. */
QWidget { background: #111722; color: #e0e7f2; font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif; }
QLabel, QCheckBox, QRadioButton { background: transparent; }
QLabel.mutedText { color: #9baac0; font-size: 12px; }
QLabel.sectionTitle { font-weight: 600; font-size: 14px; }
.TitleBar { background: #111c2d; }
.TitleBar QLabel { color: #b4c4d9; background: transparent; }
.TitleBar QLabel.icon { margin: 0; }
.TitleBar QLabel.title { margin-left: 8px; font-size: 12px; }
.TitleBar QPushButton { min-width: 34px; min-height: 26px; padding: 0; border: none; background: transparent; border-radius: 0; }
.TitleBar QPushButton:hover, .TitleBar QPushButton.topActive { background: #26394f; }
.TitleBar QPushButton.close:hover { background: #c24150; }
#workspaceToolbar { background: #1a2332; border-bottom: 1px solid #2d394d; }
#workspaceTitle { background: transparent; color: #e0e7f2; font-size: 20px; font-weight: 600; }
#connectionSummary { color: #9baac0; font-size: 12px; background: transparent; }
#connectionBadge { color: #9baac0; background: #202d42; border: 1px solid #2d394d; border-radius: 12px; padding: 5px 10px; font-size: 12px; }
#connectionBadge[state="connected"] { color: #79ddb0; background: #193b30; border: none; }
#connectionBadge[state="pending"] { color: #b45309; background: #fef3c7; border: none; }
QToolButton#workspaceAction { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; border-radius: 7px; padding: 4px 10px; }
QToolButton#workspaceAction:hover { background: #202d42; border-color: #9baac0; }
QToolButton#connectAction { background: #0e7490; border: 1px solid #0e7490; border-radius: 7px; padding: 4px 16px; color: #ffffff; font-weight: 600; }
QToolButton#connectAction:hover { background: #155e75; }
QToolButton#connectAction:disabled { background: #202d42; border-color: #2d394d; color: #9baac0; }
QToolButton::menu-indicator { width: 0; height: 0; }
#workspaceRail { background: #111c2d; }
#railLogo { color: #ffffff; background: #0e7490; border-radius: 10px; min-height: 38px; font-weight: 600; font-size: 22px; }
QToolButton#railAction { border: none; background: transparent; border-radius: 8px; }
QToolButton#railAction:hover { background: #26394f; }
QToolButton#railAction[active="true"] { background: #245064; }
#sessionSidebar { background: #1a2332; }
#sidebarHeading { background: transparent; font-size: 14px; font-weight: 600; }
#sessionSidebar QStackedWidget, #sessionSidebar QTabWidget { background: #1a2332; }
#sessionTree { background: #1a2332; border: none; padding: 0; outline: none; }
QTreeWidget::item { min-height: 32px; padding: 5px 6px; border-radius: 5px; }
QTreeWidget::item:selected { background: #253254; color: #b7c5ff; }
QTreeWidget::branch:selected { background: #253254; }
QTreeWidget::item:hover { background: #202d42; }
QGroupBox { background: #1a2332; border: 1px solid #2d394d; border-radius: 8px; margin-top: 12px; padding: 7px 0 0 0; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0 5px; color: #e0e7f2; font-weight: 600; }
QGroupBox QWidget { background: #1a2332; }
QGroupBox QLabel, QGroupBox QCheckBox, QGroupBox QRadioButton { background: transparent; }
QPushButton { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; border-radius: 6px; min-height: 26px; min-width: 50px; padding: 3px 10px; }
QPushButton:hover { background: #202d42; border-color: #9baac0; }
QPushButton:pressed { background: #253254; }
QPushButton:focus { border-color: #0e7490; }
QPushButton:disabled { color: #9baac0; background: #202d42; }
QPushButton.primaryButton, QPushButton#connectionButton { background: #0e7490; color: #ffffff; border-color: #0e7490; font-weight: 600; }
QPushButton.primaryButton:hover, QPushButton#connectionButton:hover { background: #155e75; border-color: #155e75; }
QPushButton#connectionButton.warning { background: #b45309; border-color: #b45309; }
QPushButton.smallBtn { min-width: 24px; }
QPushButton.smallBtn2, QPushButton.smallBtn3 { min-width: 22px; min-height: 22px; padding: 3px; }
QPushButton.deleteBtn { min-width: 16px; min-height: 16px; padding: 1px; }
QPushButton.bigBtn { min-height: 70px; }
QPushButton.graphBtn { max-height: 120px; }
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; border-radius: 5px; min-height: 24px; padding: 3px 7px; selection-background-color: #0e7490; selection-color: #ffffff; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #0e7490; }
QLineEdit:disabled, QComboBox:disabled { color: #9baac0; background: #202d42; }
QLineEdit.smallInput { min-height: 18px; padding: 2px 5px; }
QComboBox { min-width: 48px; padding-right: 22px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 20px; border: none; }
QComboBox::down-arrow { image: url("$DataPath/assets/arrow-down.png"); width: 9px; height: 9px; }
QComboBox QLineEdit { border: none; padding: 0; min-height: 18px; }
QComboBox QAbstractItemView { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; selection-background-color: #253254; selection-color: #b7c5ff; outline: none; }
QComboBox QAbstractItemView::item { min-height: 26px; padding: 3px 6px; }
QTextEdit, QPlainTextEdit, QListView { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; border-radius: 6px; padding: 8px; selection-background-color: #0e7490; selection-color: #ffffff; }
QWidget#receivePane { background: #111c2d; border: 1px solid #24344b; border-radius: 10px; }
#receivePane QLabel { background: transparent; color: #dce7f5; }
#receivePane QPushButton { background: #1b2b40; border: 1px solid #30425b; color: #b4c4d9; min-width: 40px; min-height: 22px; }
#receivePane QPushButton:hover { background: #273d56; }
#receivePane QLabel.rxBadge { color: #67e8f9; background: #173b4b; font-size: 11px; border-radius: 4px; padding: 3px 6px; }
#receiveConsole { background: #111c2d; color: #dce7f5; border: none; font-family: "Consolas", "Noto Sans Mono", monospace; padding: 12px 16px; }
QWidget#sendPane { background: #1a2332; border: 1px solid #2d394d; border-radius: 10px; }
#sendPane QLabel { background: transparent; }
#sendPane QLabel.txBadge { color: #b7c5ff; background: #253254; font-size: 11px; border-radius: 4px; padding: 3px 6px; }
#sendConsole { background: #1a2332; color: #e0e7f2; border: none; font-family: "Consolas", "Noto Sans Mono", monospace; padding: 8px 16px; }
QCheckBox, QRadioButton { spacing: 5px; min-height: 23px; }
QCheckBox:disabled, QRadioButton:disabled { color: #9baac0; }
QCheckBox::indicator, QRadioButton::indicator { width: 13px; height: 13px; border: 1px solid #9baac0; background: #1a2332; }
QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:checked { border-color: #0e7490; background: #0e7490; image: url("$DataPath/assets/check.svg"); }
QRadioButton::indicator:checked { width: 7px; height: 7px; border: 4px solid #0e7490; background: #1a2332; }
QTabWidget::pane { border: none; padding-top: 12px; }
QTabWidget#inspectorTabs::pane { padding-top: 4px; }
QTabBar::tab { background: transparent; color: #9baac0; border: none; border-bottom: 2px solid transparent; min-height: 26px; min-width: 44px; padding: 4px 12px; margin-right: 3px; }
QTabBar::tab:selected { background: #253254; color: #b7c5ff; border-bottom-color: #0e7490; font-weight: 600; }
QTabBar::tab:hover { background: #202d42; }
QTabBar::close-button { image: url("$DataPath/assets/close.png"); background: #9baac0; border-radius: 5px; }
QTabBar::close-button:hover { background: #c24150; }
QTabBar QToolButton { background: #1a2332; border: 1px solid #2d394d; }
QTabBar QToolButton::right-arrow { image: url("$DataPath/assets/right.png"); }
QTabBar QToolButton::left-arrow { image: url("$DataPath/assets/left.png"); }
QSplitter::handle { background: #111722; }
QSplitter::handle:hover { background: #2d394d; }
.statusBar { background: #111722; }
.statusBar QLabel { font-size: 12px; color: #9baac0; }
QScrollArea { border: none; }
QScrollBar { background: transparent; border: none; }
QScrollBar:vertical { width: 8px; }
QScrollBar:horizontal { height: 8px; }
QScrollBar::handle { background: #2d394d; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: #9baac0; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QToolTip { background: #111c2d; color: #dce7f5; border: none; padding: 7px; }
QMenu { background: #1a2332; color: #e0e7f2; border: 1px solid #2d394d; padding: 5px; }
QMenu::item { padding: 7px 24px; }
QMenu::item:selected { background: #253254; color: #b7c5ff; }
QListWidget { border: none; background: #1a2332; outline: none; }
QListWidget::item { min-height: 30px; padding: 4px 10px; }
QListWidget::item:selected { background: #253254; color: #b7c5ff; }

/* Communication workbench overrides. */
.TitleBar { background: #151d2b; border-bottom: 1px solid #2d394d; }
.TitleBar QLabel { color: #9baac0; }
.TitleBar QPushButton:hover, .TitleBar QPushButton.topActive { background: #202d42; }
.TitleBar QToolButton { border: none; background: transparent; }
.TitleBar QToolButton:hover { background: #202d42; }
#workspaceToolbar { background: #1a2332; border-bottom: 1px solid #2d394d; }
#workspaceTitle { font-size: 17px; font-weight: 600; }
#connectionSummary { color: #9baac0; font-size: 12px; }
QToolButton#workspaceAction { min-height: 26px; padding: 2px 8px; border: 1px solid transparent; background: #1a2332; color: #e0e7f2; border-radius: 6px; }
QToolButton#workspaceAction:hover { background: #202d42; border-color: #2d394d; }
QToolButton#workspaceAction[active="true"] { color: #b7c5ff; background: #253254; border-color: #2d394d; }
QToolButton#workspaceAction:focus { border-color: #425ee5; }
QToolButton#workspaceAction[iconOnly="true"] { padding: 0; }
.TitleBar QToolButton#workspaceAction { background: transparent; border: none; padding: 0; min-height: 26px; }
.TitleBar QToolButton#workspaceAction:hover { background: #253254; }
QToolButton#connectAction, QPushButton.primaryButton { background: #425ee5; border: 1px solid #425ee5; color: #ffffff; border-radius: 6px; }
QToolButton#connectAction:hover, QPushButton.primaryButton:hover { background: #334dc9; border-color: #334dc9; }
QPushButton.primaryButton:disabled { background: #202d42; border-color: #2d394d; color: #9baac0; }
#sessionSidebar { background: #151d2b; border-right: 1px solid #2d394d; }
#sessionSidebar QLabel { background: transparent; }
#sidebarHeading { font-size: 14px; }
#sessionSidebar QLineEdit { background: #1a2332; font-size: 12px; }
#sessionTree { background: #151d2b; }
QTreeWidget::item { min-height: 30px; padding: 5px 5px; border-radius: 5px; }
QTreeWidget::item:selected { background: #253254; color: #b7c5ff; }
QToolButton#newSessionButton { background: #1a2332; border: 1px solid #2d394d; border-radius: 5px; }
QToolButton#newSessionButton:hover { background: #253254; }
#inspectorDrawer { background: #1a2332; border-left: 1px solid #2d394d; }
#detachedToolbar { background: #1a2332; border-bottom: 1px solid #2d394d; }
#inspectorDrawer QStackedWidget { background: #1a2332; }
#inspectorTabs::pane { background: #1a2332; }
QTabBar::tab { padding: 4px 12px; min-height: 24px; border-bottom-width: 2px; }
QTabBar::tab:selected { background: #1a2332; border-bottom-color: #425ee5; color: #b7c5ff; }
QTabBar::close-button { image: url("$DataPath/assets/tab-close-dark.svg"); background: transparent; width: 16px; height: 16px; border-radius: 0; }
QTabBar::close-button:hover { background: #253254; }
QWidget#receivePane, QWidget#sendPane { background: #1a2332; border: 1px solid #2d394d; border-radius: 8px; }
#receivePane QLabel, #sendPane QLabel { background: transparent; color: #e0e7f2; }
#receivePane QLabel.sectionSubtitle, #sendPane QLabel.sectionSubtitle { font-size: 12px; color: #9baac0; }
#receivePane QPushButton, #sendPane QPushButton.consoleAction { background: transparent; border: 1px solid transparent; color: #9baac0; min-width: 26px; min-height: 24px; padding: 2px 6px; }
#receivePane QPushButton:hover, #sendPane QPushButton.consoleAction:hover { background: #202d42; border-color: #2d394d; }
#receivePane QPushButton.consoleAction, #sendPane QPushButton.consoleAction { min-width: 0; min-height: 0; padding: 0; border-radius: 5px; }
#receiveConsole, #sendConsole { background: #1a2332; color: #e0e7f2; border: none; padding: 12px 16px; font-family: "Consolas", "Noto Sans Mono", monospace; }
QWidget.paneHeader { background: #1a2332; border-bottom: 1px solid #2d394d; }
QWidget.paneHeading { background: transparent; }
QWidget#modeSegment { background: #202d42; border: 1px solid #2d394d; border-radius: 5px; }
QPushButton.modeButton, #receivePane QPushButton.modeButton { background: transparent; color: #9baac0; border: 1px solid transparent; border-radius: 4px; min-width: 30px; min-height: 22px; padding: 2px 8px; }
QPushButton.modeButton:checked, #receivePane QPushButton.modeButton:checked { background: #1a2332; color: #b7c5ff; border-color: #2d394d; }
QPushButton.modeButton:focus { border-color: #425ee5; }
#receiveEmptyState { background: transparent; }
#receiveEmptyState QLabel.emptyStateTitle { font-size: 18px; font-weight: 600; color: #e0e7f2; background: transparent; }
#receiveEmptyState QLabel.emptyStateSubtitle { font-size: 13px; color: #9baac0; background: transparent; }
#composerFooter { background: #1a2332; border-top: 1px solid #2d394d; }
QComboBox#sendHistory { min-width: 152px; max-width: 220px; }
#sendPane QPushButton.primaryButton { min-width: 84px; min-height: 26px; padding: 3px 14px; }
#sendConnectionHint { color: #9baac0; font-size: 12px; }
.statusBar QLabel { font-size: 12px; color: #9baac0; }
.statusBar QLabel.rxCounter { color: #b7c5ff; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #425ee5; }
QCheckBox::indicator:checked { background: #425ee5; border-color: #425ee5; }
QRadioButton::indicator:checked { border-color: #425ee5; }
